table '_Key Measures'
	lineageTag: 115f8c5a-02cf-4d0c-8e25-e4d12ad8f5b2

	measure 'Total Jobs' = DISTINCTCOUNT((fact_job[job_id]))
		formatString: 0
		lineageTag: 24d0f222-ac43-4c3b-bbac-ac10beadfce7

	measure 'Countries Per Job' =
			
			CALCULATE(
			    DISTINCTCOUNT(fact_job[country_code]),
			    ALLEXCEPT(
			        fact_job,
			        fact_job[job_id]
			    )
			)
		formatString: 0
		lineageTag: 6d23c245-5efc-4f44-921a-01db37285456

	measure 'AI Mentions' =
			
			VAR VisibleJobs =
			    VALUES(fact_job[job_id])
			RETURN
			    CALCULATE(
			        SUM(dim_job[ai_mention]),
			        TREATAS(
			            VisibleJobs,
			            dim_job[job_id]
			        )
			    )
		formatString: 0
		lineageTag: bf7c037e-48e9-4652-a2a0-78ed677b5ca9

	measure 'Avg. Hard Skills / Job' =
			
			AVERAGEX(
			    VALUES(fact_job[job_id]),
			    CALCULATE(
			        DISTINCTCOUNT(fact_job[hard_skill_id]),
			        fact_job[hard_skill_id] <> 0
			    )
			)
		formatString: 0
		lineageTag: 2e80ad81-f846-4417-b0af-b6d9e9099e4d

	partition '_Key Measures' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

